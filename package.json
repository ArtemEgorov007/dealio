{
  "name": "dealio",
  "description": "Dealio — трекер идей, задач и желаний с kanban-доской на Nuxt 4",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:contract": "node --test tests/*.test.mjs",
    "verify": "npm run test:contract && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@nuxt/icon": "^2.0.0",
    "@nuxt/ui": "^3.3.3",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@pinia/nuxt": "^0.11.2",
    "@tanstack/vue-query": "^5.85.6",
    "@vee-validate/nuxt": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "appwrite": "^18.2.0",
    "dayjs": "^1.11.18",
    "nuxt": "^4.0.3",
    "qr-scanner": "^1.4.2",
    "uuid": "^11.1.0",
    "vue": "^3.5.19",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.6.0",
    "sass-embedded": "^1.90.0",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "crossws": "0.3.5"
  }
}
